{
  "name": "quotation-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --run dev:server & vite",
    "dev:server": "node --watch server/index.ts",
    "build": "tsc -b && tsc -p server && vite build",
    "start": "node server/index.ts",
    "test": "node --test server/*.test.ts",
    "preview": "vite preview",
    "lint": "eslint"
  },
  "dependencies": {
